{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etat-major-personnel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "etat-major-personnel",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "APP_NAME": "État-Major Personnel"
  }
}
